{
  "name": "next-webmcp",
  "version": "0.1.0",
  "description": "Route-scoped WebMCP tools for the Next.js App Router: expose server actions as tools agents can call, with inline human approval and DevTools.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "packageManager": "pnpm@10.15.0",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "react-server": "./dist/index.server.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./form": {
      "types": "./dist/form.d.ts",
      "import": "./dist/form.js",
      "default": "./dist/form.js"
    },
    "./devtools": {
      "types": "./dist/devtools.d.ts",
      "import": "./dist/devtools.js",
      "default": "./dist/devtools.js"
    },
    "./manifest": {
      "types": "./dist/manifest.d.ts",
      "import": "./dist/manifest.js",
      "default": "./dist/manifest.js"
    },
    "./internal": {
      "types": "./dist/internal.d.ts",
      "import": "./dist/internal.js",
      "default": "./dist/internal.js"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "form": [
        "./dist/form.d.ts"
      ],
      "devtools": [
        "./dist/devtools.d.ts"
      ],
      "manifest": [
        "./dist/manifest.d.ts"
      ],
      "internal": [
        "./dist/internal.d.ts"
      ]
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:examples": "pnpm -r --filter './examples/*' typecheck",
    "build:examples": "pnpm -r --filter './examples/*' build",
    "example:commerce": "pnpm --filter example-commerce dev",
    "example:minimal": "pnpm --filter example-minimal dev",
    "lint": "prettier --check .",
    "format": "prettier --write .",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "next": ">=15",
    "react": ">=19",
    "react-dom": ">=19",
    "zod": "^4"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19.0.4",
    "jsdom": "^26.1.0",
    "next": "15.6.0-canary.60",
    "prettier": "^3.5.3",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "tsdown": "^0.23.0",
    "typescript": "5.8.2",
    "vitest": "^3.2.4",
    "webmcp-types": "^0.1.6",
    "zod": "^4.5.4"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pane2004/next-webmcp.git"
  },
  "homepage": "https://github.com/pane2004/next-webmcp#readme",
  "bugs": {
    "url": "https://github.com/pane2004/next-webmcp/issues"
  },
  "keywords": [
    "webmcp",
    "nextjs",
    "next",
    "mcp",
    "agents",
    "server-actions",
    "model-context",
    "ai"
  ],
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  }
}
