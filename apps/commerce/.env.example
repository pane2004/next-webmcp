# No configuration is required. Without SHOPIFY_* variables the app runs in
# mock mode: an in-memory catalog (lib/mock) with a cookie-backed cart and a
# demo checkout at /checkout.

# Display names. Optional; lib/mock/env.ts fills these defaults in at startup
# when they are unset, so the layout, navbar and footer always have a value.
COMPANY_NAME="Acme Store"
SITE_NAME="Next.js Commerce × WebMCP"

# Optional. Set BOTH to switch from mock mode to a real Shopify store.
# SHOPIFY_STORE_DOMAIN="[your-shopify-store-subdomain].myshopify.com"
# SHOPIFY_STOREFRONT_ACCESS_TOKEN=""

# Optional. Only used by the Shopify webhook handler (POST /api/revalidate).
# SHOPIFY_REVALIDATION_SECRET=""
