{
  "name": "next-webmcp",
  "version": "0.1.0",
  "description": "Route-scoped WebMCP tools for Next.js App Router: expose server actions as tools agents can call, with inline human approval and DevTools.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "files": ["dist", "README.md", "LICENSE"],
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js", "default": "./dist/index.js" },
    "./form": { "types": "./dist/form.d.ts", "import": "./dist/form.js", "default": "./dist/form.js" },
    "./devtools": { "types": "./dist/devtools.d.ts", "import": "./dist/devtools.js", "default": "./dist/devtools.js" },
    "./config": { "types": "./dist/config.d.ts", "import": "./dist/config.js", "default": "./dist/config.js" },
    "./internal": { "types": "./dist/internal.d.ts", "import": "./dist/internal.js", "default": "./dist/internal.js" },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "prettier --check src",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "next": ">=15",
    "react": ">=19",
    "react-dom": ">=19",
    "zod": ">=3.25"
  },
  "peerDependenciesMeta": {
    "zod": { "optional": false }
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19.0.4",
    "jsdom": "^26.1.0",
    "next": "15.6.0-canary.60",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "tsdown": "^0.23.0",
    "typescript": "5.8.2",
    "vitest": "^3.2.4",
    "webmcp-types": "^0.1.6",
    "zod": "^4.5.4"
  },
  "engines": { "node": ">=20" },
  "repository": { "type": "git", "url": "git+https://github.com/pane2004/next-webmcp.git", "directory": "packages/next-webmcp" },
  "homepage": "https://github.com/pane2004/next-webmcp#readme",
  "bugs": { "url": "https://github.com/pane2004/next-webmcp/issues" },
  "keywords": ["webmcp", "nextjs", "next", "mcp", "agents", "server-actions", "model-context", "ai"]
}
